{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "3 days",
  "timezone": "Asia/Jerusalem",
  "schedule": [
    "before 6am on sunday"
  ],
  "rebaseWhen": "conflicted",
  "labels": [
    "renovate 🎨"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "rangeStrategy": "bump"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Docker images used in workflow run scripts",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "docker run [^\\n]*?\\s(?<depName>[a-z0-9][a-z0-9._/-]*):(?<currentValue>\\d[\\w.-]*)\\s"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
